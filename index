                ]
            },
            {
                titre: "C'est pour (Veridis Remix)",
                artiste: "Vald (Veridis Project)",
                typeMedia: "demo",
                fichierMedia: "medias/vald-cest-pour.mp3",
                pochetteUrl: "",
                couleurPochette: "#6366f1",
                tirageAleatoire: false,
                nombreQuestionsAPoser: 1,
                banqueQuestions: [
                    {
                        debutSecondes: 0,
                        pauseSecondes: 12,
                        repriseFinSecondes: 18,
                        citation: "« C'est pour les miens, pour ceux qui galèrent en silence et gardent le sourire malgré les coups durs... »",
                        question: "Quelle est la signification principale des premières paroles de « C'est pour » de Vald ?",
                        options: [
