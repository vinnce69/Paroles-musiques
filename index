                        ],
                        bonneReponseIndex: 0,
                        explication: "Dès les premières mesures, Vald pose un texte sincère et fédérateur : il dédie le morceau à son cercle proche (« les miens ») et à toutes les personnes qui affrontent les difficultés du quotidien sans se plaindre."
                    }
                ]
            }

            /* === MODÈLE À COPIER-COLLER POUR AJOUTER UNE NOUVELLE CHANSON ===
            ,
            {
                titre: "Nom du morceau",
                artiste: "Nom de l'artiste",
                typeMedia: "mp4", // ou "mp3" ou "demo"
                fichierMedia: "videos/mon-extrait.mp4",
                pochetteUrl: "", // Optionnel en mode mp3 (ex: "images/pochette.jpg")
                couleurPochette: "#ec4899",
                tirageAleatoire: false,
                nombreQuestionsAPoser: 1,
                banqueQuestions: [
                    {
                        debutSecondes: 10,
                        pauseSecondes: 25,
                        repriseFinSecondes: 33,
                        citation: "« Extrait des paroles entendues juste avant la pause... »",
                        question: "Ta question ici ?",
                        options: [
                            "Bonne réponse",
                            "Mauvaise réponse 1",
                            "Mauvaise réponse 2",
                            "Mauvaise réponse 3"
                        ],
                        bonneReponseIndex: 0,
                        explication: "Explication affichée après la réponse."
                    }
                ]
            }
            */
        ];

        // =====================================================================
        // 2. VARIABLES D'ÉTAT DU LECTEUR HYBRIDE
        // =====================================================================
        let fileManches = [];
        let indexMancheActuelle = 0;
        let score = 0;
        let modeActif = "demo";             // "mp4" | "mp3" | "demo"
        let phaseLecture = "vers_pause";    // "vers_pause" | "en_pause" | "reprise_suite"
        let estEnLecture = false;
        let questionDejaRepondue = false;
        let timerPrincipal = null;

        // Variables dédiées au simulateur Web Audio API (Mode Démo intégré)
        let contexteAudioDemo = null;
        let intervalleBeatDemo = null;
        let tempsDemoActuel = 0;
        let dernierTimestampDemo = 0;
        let pasRythmeDemo = 0;

        // Références DOM
        const videoEl = document.getElementById("lecteur-video-mp4");
        const audioEl = document.getElementById("lecteur-audio-mp3");
        const sceneVisuelleAudio = document.getElementById("scene-visuelle-audio");

        // =====================================================================
        // 3. INITIALISATION & ÉVÉNEMENTS TACTILES
        // =====================================================================
        document.addEventListener("DOMContentLoaded", () => {
            construireListeAccueil();

            document.getElementById("btn-demarrer-tout").addEventListener("click", () => {
                demarrerPartie(null);
            });

            // Bouton Pause / Lecture
            document.getElementById("btn-pause-lecture").addEventListener("click", () => {
                if (estEnLecture) {
                    mettreEnPauseMedia();
                    document.getElementById("statut-lecture").textContent = "⏸️ En pause manuelle";
                } else {
                    reprendreLectureMedia();
                    document.getElementById("statut-lecture").textContent = "🎧 Lecture en cours...";
                }
            });

            // Bouton Réécouter le passage
            document.getElementById("btn-reecouter").addEventListener("click", () => {
                const manche = fileManches[indexMancheActuelle];
                if (!manche) return;
                phaseLecture = "vers_pause";
                cacherElement("overlay-pause");
                positionnerMediaASeconde(manche.question.debutSecondes);
                reprendreLectureMedia();
                document.getElementById("statut-lecture").textContent = "⏪ Réécoute du passage...";
            });

            // Bouton Passer directement à la question
            document.getElementById("btn-passer-question").addEventListener("click", () => {
                declencherPauseEtQuestion();
            });

            // Gestion des boutons de secours en cas de fichier MP3/MP4 manquant
            document.getElementById("btn-basculer-demo").addEventListener("click", () => {
                const manche = fileManches[indexMancheActuelle];
                if (!manche) return;
                manche.typeMedia = "demo";
                cacherElement("zone-erreur-fichier");
                chargerManche(indexMancheActuelle);
            });

            document.getElementById("btn-erreur-voir-question").addEventListener("click", () => {
                cacherElement("zone-erreur-fichier");
                declencherPauseEtQuestion();
            });

            // Bouton Écouter la suite après avoir répondu
            document.getElementById("btn-ecouter-suite").addEventListener("click", () => {
                const manche = fileManches[indexMancheActuelle];
                if (!manche) return;
                phaseLecture = "reprise_suite";
                cacherElement("overlay-pause");
                positionnerMediaASeconde(manche.question.pauseSecondes);
                reprendreLectureMedia();
                document.getElementById("statut-lecture").textContent = "🔊 Lecture de la suite...";
            });

            // Bouton Continuer vers la manche suivante
            document.getElementById("btn-manche-suivante").addEventListener("click", () => {
                if (indexMancheActuelle + 1 < fileManches.length) {
                    chargerManche(indexMancheActuelle + 1);
                } else {
                    afficherFinDePartie();
                }
            });

            // Écran final
            document.getElementById("btn-rejouer").addEventListener("click", () => {
                demarrerPartie(null);
            });

            document.getElementById("btn-retour-accueil").addEventListener("click", () => {
                arreterToutMedia();
                afficherEcran("ecran-accueil");
            });

            // Détection d'erreur de fichier sur <video> et <audio>
            videoEl.addEventListener("error", () => {
                if (modeActif === "mp4") signalerErreurFichier();
            });
            audioEl.addEventListener("error", () => {
                if (modeActif === "mp3") signalerErreurFichier();
            });
        });

        // Génère les boutons des morceaux disponibles sur l'écran d'accueil
        function construireListeAccueil() {
            const conteneur = document.getElementById("liste-morceaux-accueil");
            conteneur.innerHTML = "";

            CHANSONS.forEach((chanson, index) => {
                const etiquetteType = chanson.typeMedia === "mp4"
                    ? "🎬 Vidéo MP4"
                    : (chanson.typeMedia === "mp3" ? "🎵 Audio MP3" : "🎛️ Démo intégrée");

                const btn = document.createElement("button");
                btn.className = "carte-morceau-choix";
                btn.innerHTML = `
                    <div style="min-width: 0;">
                        <div style="font-weight: 800; font-size: 0.98rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            ${chanson.titre}
                        </div>
                        <div style="font-size: 0.84rem; color: var(--couleur-texte-doux);">
                            ${chanson.artiste} • <span style="color: var(--couleur-principale);">${etiquetteType}</span>
                        </div>
                    </div>
                    <span style="color: var(--couleur-principale); font-weight: 800; font-size: 0.92rem; flex-shrink: 0;">
                        Jouer ▶
                    </span>
                `;
                btn.addEventListener("click", () => demarrerPartie(index));
                conteneur.appendChild(btn);
            });
        }

        // =====================================================================
        // 4. PRÉPARATION DE LA PARTIE
        // =====================================================================
        function demarrerPartie(indexChansonUnique) {
            score = 0;
            indexMancheActuelle = 0;
            fileManches = [];

            const selection = indexChansonUnique !== null
                ? [CHANSONS[indexChansonUnique]]
                : CHANSONS;

            selection.forEach((chanson) => {
                let pool = [...chanson.banqueQuestions];
                if (chanson.tirageAleatoire) {
                    pool.sort(() => Math.random() - 0.5);
                }
                const retenues = pool.slice(0, chanson.nombreQuestionsAPoser);

                retenues.forEach((q) => {
                    fileManches.push({
                        titre: chanson.titre,
                        artiste: chanson.artiste,
                        typeMedia: chanson.typeMedia || "demo",
                        fichierMedia: chanson.fichierMedia || "",
                        pochetteUrl: chanson.pochetteUrl || "",
                        couleurPochette: chanson.couleurPochette || "#1db954",
                        question: q
                    });
                });
            });

            mettreAJourBadgeScore();
            afficherEcran("ecran-jeu");
            chargerManche(0);
        }

        // =====================================================================
        // 5. CHARGEMENT D'UNE MANCHE & CONFIGURATION DU LECTEUR HYBRIDE
        // =====================================================================
        function chargerManche(index) {
            arreterToutMedia();
            indexMancheActuelle = index;
            questionDejaRepondue = false;
            phaseLecture = "vers_pause";

            const manche = fileManches[index];
            if (!manche) {
                afficherFinDePartie();
                return;
            }

            modeActif = manche.typeMedia;

            // Mise à jour des textes d'en-tête
            document.getElementById("numero-manche").textContent = `Manche ${index + 1} / ${fileManches.length}`;
            document.getElementById("statut-lecture").textContent = "🎧 Écoute attentivement les paroles...";
            document.getElementById("info-titre").textContent = manche.titre;
            document.getElementById("info-artiste").textContent = manche.artiste;

            // Réinitialisation des panneaux
            cacherElement("overlay-pause");
            cacherElement("zone-erreur-fichier");
            cacherElement("carte-question");
            cacherElement("zone-feedback");

            // Placement visuel du repère doré sur la barre de progression
            const debut = manche.question.debutSecondes;
            const pause = manche.question.pauseSecondes;
            const finSuite = manche.question.repriseFinSecondes || (pause + 6);
            const dureeTotaleExtrait = Math.max(1, finSuite - debut);
            const positionReperePourcent = Math.min(100, Math.max(10, ((pause - debut) / dureeTotaleExtrait) * 100));

            document.getElementById("repere-pause").style.left = positionReperePourcent + "%";
            document.getElementById("texte-repere-pause").textContent = `Pause à ${formaterSecondes(pause)}`;
            document.getElementById("remplissage-progression").style.width = "0%";
            document.getElementById("texte-chrono").textContent = `${formaterSecondes(debut)} / ${formaterSecondes(finSuite)}`;

            // Configuration de la scène visuelle selon le typeMedia ("mp4", "mp3" ou "demo")
            if (modeActif === "mp4") {
                cacherElement("scene-visuelle-audio");
                afficherElement("lecteur-video-mp4");
                videoEl.src = manche.fichierMedia;
                videoEl.currentTime = debut;
                reprendreLectureMedia();
            } else if (modeActif === "mp3") {
                cacherElement("lecteur-video-mp4");
                afficherElement("scene-visuelle-audio");
                document.getElementById("badge-type-media").textContent = "🎵 Audio MP3";
                document.getElementById("sous-titre-scene").textContent = `${manche.artiste} — ${manche.titre}`;
                genererVisuelPochette(manche);
                audioEl.src = manche.fichierMedia;
                audioEl.currentTime = debut;
                reprendreLectureMedia();
            } else {
                // Mode "demo" intégré (aucun fichier requis)
                cacherElement("lecteur-video-mp4");
                afficherElement("scene-visuelle-audio");
                document.getElementById("badge-type-media").textContent = "🎛️ Mode Démo Synthétique";
                document.getElementById("sous-titre-scene").textContent = "Simulation d'extrait musical en cours...";
                genererVisuelPochette(manche);
                tempsDemoActuel = debut;
                reprendreLectureMedia();
            }

            demarrerSurveillanceChrono();
        }

        // Génère soit l'image pochetteUrl, soit une pochette SVG stylisée aux couleurs du morceau
        function genererVisuelPochette(manche) {
            const cadre = document.getElementById("cadre-pochette");
            if (manche.pochetteUrl) {
                cadre.innerHTML = `<img src="${manche.pochetteUrl}" alt="Pochette" onerror="this.style.display='none'">`;
                return;
            }

            const initiales = manche.artiste
                .split(" ")
                .slice(0, 2)
                .map((mot) => mot[0] || "")
                .join("")
                .toUpperCase();

            cadre.innerHTML = `
                <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="gradPochette" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="${manche.couleurPochette}" />
                            <stop offset="100%" stop-color="#0f172a" />
                        </linearGradient>
                    </defs>
                    <rect width="120" height="120" fill="url(#gradPochette)" />
                    <circle cx="60" cy="60" r="38" fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="2" />
                    <circle cx="60" cy="60" r="10" fill="rgba(255,255,255,0.25)" />
                    <text x="60" y="66" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="800" font-size="22">
                        ${initiales}
                    </text>
                </svg>
            `;
        }

        // =====================================================================
        // 6. CONTRÔLE UNIFIÉ DU MÉDIA (LECTURE, PAUSE, POSITION, SYNTHÉ DÉMO)
        // =====================================================================
        function reprendreLectureMedia() {
            estEnLecture = true;
            document.getElementById("btn-pause-lecture").textContent = "⏸ Pause";
            sceneVisuelleAudio.classList.add("en-lecture");

            if (modeActif === "mp4") {
                videoEl.play().catch(() => {
                    estEnLecture = false;
                    document.getElementById("btn-pause-lecture").textContent = "▶ Lecture";
                });
            } else if (modeActif === "mp3") {
                audioEl.play().catch(() => {
                    estEnLecture = false;
                    document.getElementById("btn-pause-lecture").textContent = "▶ Lecture";
                });
            } else {
                demarrerAudioSynthetiqueDemo();
            }
        }

        function mettreEnPauseMedia() {
            estEnLecture = false;
            document.getElementById("btn-pause-lecture").textContent = "▶ Lecture";
            sceneVisuelleAudio.classList.remove("en-lecture");

            if (modeActif === "mp4") {
                videoEl.pause();
            } else if (modeActif === "mp3") {
                audioEl.pause();
            } else {
                arreterAudioSynthetiqueDemo();
            }
        }

        function positionnerMediaASeconde(seconde) {
            if (modeActif === "mp4") {
                videoEl.currentTime = seconde;
            } else if (modeActif === "mp3") {
                audioEl.currentTime = seconde;
            } else {
                tempsDemoActuel = seconde;
                dernierTimestampDemo = performance.now();
            }
        }

        function obtenirTempsActuelMedia() {
            if (modeActif === "mp4") return videoEl.currentTime || 0;
            if (modeActif === "mp3") return audioEl.currentTime || 0;

            if (estEnLecture) {
                const maintenant = performance.now();
                tempsDemoActuel += (maintenant - dernierTimestampDemo) / 1000;
                dernierTimestampDemo = maintenant;
            }
            return tempsDemoActuel;
        }

        function arreterToutMedia() {
            estEnLecture = false;
            clearInterval(timerPrincipal);
            timerPrincipal = null;
            videoEl.pause();
            audioEl.pause();
            arreterAudioSynthetiqueDemo();
            sceneVisuelleAudio.classList.remove("en-lecture");
        }

        function signalerErreurFichier() {
            arreterToutMedia();
            const manche = fileManches[indexMancheActuelle];
            document.getElementById("statut-lecture").textContent = "⚠️ Fichier non chargé";
            document.getElementById("detail-erreur-fichier").innerHTML =
                `Impossible de lire <code>${manche ? manche.fichierMedia : ""}</code>. Clique ci-dessous pour tester avec le mode démo intégré !`;
            afficherElement("zone-erreur-fichier");
        }

        // Générateur de rythme instrumental doux via Web Audio API (pour tester sans fichier)
        function demarrerAudioSynthetiqueDemo() {
            dernierTimestampDemo = performance.now();
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!contexteAudioDemo && AudioCtx) {
                    contexteAudioDemo = new AudioCtx();
                }
                if (contexteAudioDemo && contexteAudioDemo.state === "suspended") {
                    contexteAudioDemo.resume();
                }
            } catch (e) {
                // Si le navigateur bloque le son, le chronomètre visuel continue quand même
            }

            clearInterval(intervalleBeatDemo);
            pasRythmeDemo = 0;

            const jouerNoteBeat = () => {
                if (!estEnLecture || !contexteAudioDemo) return;
                const t = contexteAudioDemo.currentTime;
                const osc = contexteAudioDemo.createOscillator();
                const gain = contexteAudioDemo.createGain();

                // Alternance basse kick / accord mélodique doux
                const notes = [110, 164.81, 130.81, 196.00];
                osc.type = pasRythmeDemo % 2 === 0 ? "triangle" : "sine";
                osc.frequency.setValueAtTime(notes[pasRythmeDemo % notes.length], t);

                gain.gain.setValueAtTime(0.06, t);
                gain.gain.exponentialRampToValueAtTime(0.001, t + 0.28);

                osc.connect(gain);
                gain.connect(contexteAudioDemo.destination);
                osc.start(t);
                osc.stop(t + 0.3);
                pasRythmeDemo++;
            };

            jouerNoteBeat();
            intervalleBeatDemo = setInterval(jouerNoteBeat, 460);
        }

        function arreterAudioSynthetiqueDemo() {
            clearInterval(intervalleBeatDemo);
            intervalleBeatDemo = null;
        }

        // =====================================================================
        // 7. SURVEILLANCE DU CHRONOMÈTRE & DÉCLENCHEMENT DE LA PAUSE
        // =====================================================================
        function demarrerSurveillanceChrono() {
            clearInterval(timerPrincipal);

            timerPrincipal = setInterval(() => {
                const manche = fileManches[indexMancheActuelle];
                if (!manche) return;

                const temps = obtenirTempsActuelMedia();
                const debut = manche.question.debutSecondes;
                const pause = manche.question.pauseSecondes;
                const finSuite = manche.question.repriseFinSecondes || (pause + 6);
                const dureeTotale = Math.max(1, finSuite - debut);

                // Mise à jour de la barre de progression et du chronomètre
                const pourcent = Math.min(100, Math.max(0, ((temps - debut) / dureeTotale) * 100));
                document.getElementById("remplissage-progression").style.width = pourcent + "%";
                document.getElementById("texte-chrono").textContent = `${formaterSecondes(temps)} / ${formaterSecondes(finSuite)}`;

                // Déclenchement automatique de la pause et de la question
                if (phaseLecture === "vers_pause" && temps >= pause) {
                    declencherPauseEtQuestion();
                }

                // Arrêt propre à la fin de l'extrait après la réponse
                if (phaseLecture === "reprise_suite" && temps >= finSuite) {
                    mettreEnPauseMedia();
                    phaseLecture = "en_pause";
                    document.getElementById("statut-lecture").textContent = "✅ Fin de l'extrait";
                }
            }, 100);
        }

        function declencherPauseEtQuestion() {
            phaseLecture = "en_pause";
            mettreEnPauseMedia();

            const manche = fileManches[indexMancheActuelle];
            if (manche) {
                positionnerMediaASeconde(manche.question.pauseSecondes);
            }

            document.getElementById("statut-lecture").textContent = "⏸️ Pause question";
            afficherElement("overlay-pause");
            afficherCarteQuestion();
        }

        // =====================================================================
        // 8. AFFICHAGE DE LA QUESTION & VÉRIFICATION DES RÉPONSES
        // =====================================================================
        function afficherCarteQuestion() {
            const manche = fileManches[indexMancheActuelle];
            const q = manche.question;

            document.getElementById("texte-citation").textContent = q.citation || "";
            document.getElementById("texte-question").textContent = q.question;

            const conteneur = document.getElementById("liste-options");
            conteneur.innerHTML = "";
            const lettres = ["A", "B", "C", "D"];

            q.options.forEach((texteOption, idx) => {
                const btn = document.createElement("button");
                btn.className = "btn-option";
                btn.innerHTML = `
                    <span class="lettre-option">${lettres[idx]}</span>
                    <span>${texteOption}</span>
                `;
                btn.addEventListener("click", () => verifierReponse(idx));
                conteneur.appendChild(btn);
            });

            afficherElement("carte-question");
            document.getElementById("carte-question").scrollIntoView({ behavior: "smooth", block: "nearest" });
        }

        function verifierReponse(indexChoisi) {
            if (questionDejaRepondue) return;
            questionDejaRepondue = true;

            const manche = fileManches[indexMancheActuelle];
            const bonneIndex = manche.question.bonneReponseIndex;
            const boutons = document.querySelectorAll("#liste-options .btn-option");

            boutons.forEach((btn, idx) => {
                btn.disabled = true;
                if (idx === bonneIndex) {
                    btn.classList.add("correct");
                } else if (idx === indexChoisi) {
                    btn.classList.add("incorrect");
                }
            });

            const estCorrect = indexChoisi === bonneIndex;
            if (estCorrect) score++;
            mettreAJourBadgeScore();

            const titreFeedback = document.getElementById("titre-feedback");
            if (estCorrect) {
                titreFeedback.textContent = "✅ Bonne réponse !";
                titreFeedback.style.color = "var(--couleur-succes)";
            } else {
                titreFeedback.textContent = "❌ Mauvaise réponse !";
                titreFeedback.style.color = "var(--couleur-erreur)";
            }

            document.getElementById("texte-explication").textContent = manche.question.explication;
            afficherElement("zone-feedback");
            document.getElementById("zone-feedback").scrollIntoView({ behavior: "smooth", block: "nearest" });
        }

        function afficherFinDePartie() {
            arreterToutMedia();
            document.getElementById("score-final-texte").textContent = `Score final : ${score} / ${fileManches.length}`;
            afficherEcran("ecran-fin");
        }

        // =====================================================================
        // 9. UTILITAIRES D'INTERFACE
        // =====================================================================
        function formaterSecondes(sec) {
            const total = Math.max(0, Math.floor(sec));
            const minutes = Math.floor(total / 60);
            const secondes = total % 60;
            return `${minutes}:${secondes < 10 ? "0" : ""}${secondes}`;
        }

        function mettreAJourBadgeScore() {
            document.getElementById("affichage-score").textContent = `Score : ${score} / ${fileManches.length}`;
        }

        function afficherEcran(id) {
            ["ecran-accueil", "ecran-jeu", "ecran-fin"].forEach((ecran) => {
                document.getElementById(ecran).classList.add("cache");
            });
            document.getElementById(id).classList.remove("cache");
        }

        function afficherElement(id) {
            document.getElementById(id).classList.remove("cache");
        }

        function cacherElement(id) {
            document.getElementById(id).classList.add("cache");
        }
    </script>
</body>
</html>
