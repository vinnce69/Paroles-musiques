<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <!-- Indispensable pour l'adaptation sur téléphone (empêche le zoom involontaire au clic) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Quiz Paroles Hybride (MP4 / MP3 + Pochette animée)</title>

    <style>
        /* =====================================================================
           1. PERSONNALISATION DU DESIGN (COULEURS & TAILLES)
           Tu peux modifier les codes couleurs ci-dessous très facilement !
           ===================================================================== */
        :root {
            --couleur-fond: #0d0f14;            /* Fond général très sombre */
            --fond-carte: #171a24;              /* Fond des encadrés / cartes */
            --couleur-bordure: #292e3f;         /* Bordures subtiles */
            --couleur-principale: #1db954;      /* Vert principal (boutons, accents) */
            --couleur-principale-claire: #23d863;
            --couleur-repere-pause: #f59e0b;    /* Couleur dorée/orange du marqueur de pause */
            --couleur-texte: #ffffff;           /* Texte principal blanc */
            --couleur-texte-doux: #9ca3af;      /* Texte secondaire gris clair */
            
            /* Couleurs pour les réponses du quiz */
            --couleur-succes: #10b981;          /* Vert bonne réponse */
            --couleur-erreur: #ef4444;          /* Rouge mauvaise réponse */
            --couleur-alerte: #f59e0b;          /* Orange messages d'alerte */
            
            --arrondi: 18px;                    /* Arrondi des cartes et boutons */
        }

        /* =====================================================================
           2. STYLE GÉNÉRAL & ADAPTATION MOBILE-FIRST
           ===================================================================== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--couleur-fond);
            color: var(--couleur-texte);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 16px;
            line-height: 1.5;
        }

        .conteneur {
            width: 100%;
            max-width: 580px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* En-tête fixe avec logo et score */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--fond-carte);
            padding: 12px 18px;
            border-radius: var(--arrondi);
            border: 1px solid var(--couleur-bordure);
        }

        .logo {
            font-weight: 800;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--couleur-principale);
        }

        .badge-score {
            background: rgba(29, 185, 84, 0.15);
            color: var(--couleur-principale);
            border: 1px solid var(--couleur-principale);
            padding: 6px 14px;
            border-radius: 99px;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .carte {
            background: var(--fond-carte);
            border: 1px solid var(--couleur-bordure);
            border-radius: var(--arrondi);
            padding: 20px 18px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        }

        .cache {
            display: none !important;
        }

        /* =====================================================================
           3. LECTEUR HYBRIDE (VIDÉO MP4 16:9 OU POCHETTE ALBUM + ÉGALISEUR)
           ===================================================================== */
        .scene-media {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #08090d;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--couleur-bordure);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Mode MP4 : vidéo fluide sans contrôles natifs encombrants */
        .scene-media video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* Mode MP3 / Démo : scène visuelle avec halo flouté + pochette + égaliseur */
        .scene-audio {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            overflow: hidden;
        }

        .halo-arriere-plan {
            position: absolute;
            inset: -20px;
            background: radial-gradient(circle at 30% 30%, rgba(29, 185, 84, 0.45), transparent 60%),
                        radial-gradient(circle at 75% 70%, rgba(99, 102, 241, 0.4), transparent 60%);
            filter: blur(22px);
            transform: scale(1.1);
            transition: transform 0.6s ease, opacity 0.6s ease;
            z-index: 1;
        }

        .scene-audio.en-lecture .halo-arriere-plan {
            animation: pulsationHalo 3.5s ease-in-out infinite alternate;
        }

        @keyframes pulsationHalo {
            0% { transform: scale(1.05) rotate(0deg); opacity: 0.75; }
            100% { transform: scale(1.22) rotate(6deg); opacity: 1; }
        }

        .contenu-pochette {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 16px;
            width: 100%;
            max-width: 440px;
        }

        /* Pochette carrée (image URL ou pochette SVG générée automatiquement) */
        .cadre-pochette {
            width: 104px;
            height: 104px;
            border-radius: 14px;
            overflow: hidden;
            flex-shrink: 0;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: #1e2230;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cadre-pochette img,
        .cadre-pochette svg {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .infos-audio-scene {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .badge-mode-media {
            display: inline-flex;
            align-self: flex-start;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            padding: 3px 9px;
            border-radius: 99px;
            background: rgba(255, 255, 255, 0.12);
            color: #e5e7eb;
        }

        /* Égaliseur audio animé (barres de fréquence) */
        .egaliseur {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            height: 30px;
            margin-top: 2px;
        }

        .barre-eq {
            width: 5px;
            height: 6px;
            background: var(--couleur-principale);
            border-radius: 99px;
            transition: height 0.15s ease;
        }

        .scene-audio.en-lecture .barre-eq {
            animation: danseEgaliseur 0.7s ease-in-out infinite alternate;
        }

        .scene-audio.en-lecture .barre-eq:nth-child(1) { animation-duration: 0.55s; animation-delay: 0.05s; }
        .scene-audio.en-lecture .barre-eq:nth-child(2) { animation-duration: 0.75s; animation-delay: 0.20s; }
        .scene-audio.en-lecture .barre-eq:nth-child(3) { animation-duration: 0.48s; animation-delay: 0.10s; }
        .scene-audio.en-lecture .barre-eq:nth-child(4) { animation-duration: 0.82s; animation-delay: 0.30s; }
        .scene-audio.en-lecture .barre-eq:nth-child(5) { animation-duration: 0.60s; animation-delay: 0.15s; }
        .scene-audio.en-lecture .barre-eq:nth-child(6) { animation-duration: 0.70s; animation-delay: 0.25s; }
        .scene-audio.en-lecture .barre-eq:nth-child(7) { animation-duration: 0.52s; animation-delay: 0.08s; }
        .scene-audio.en-lecture .barre-eq:nth-child(8) { animation-duration: 0.68s; animation-delay: 0.18s; }

        @keyframes danseEgaliseur {
            0% { height: 6px; opacity: 0.65; }
            100% { height: 28px; opacity: 1; }
        }

        /* Overlay affiché quand la question se déclenche */
        .overlay-pause {
            position: absolute;
            inset: 0;
            background: rgba(13, 15, 20, 0.8);
            backdrop-filter: blur(4px);
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 16px;
            gap: 6px;
        }

        /* =====================================================================
           4. BARRE DE PROGRESSION AVEC REPÈRE DE PAUSE & CHRONOMÈTRE
           ===================================================================== */
        .bloc-chronometre {
            margin-top: 14px;
        }

        .ligne-temps {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.82rem;
            color: var(--couleur-texte-doux);
            margin-bottom: 6px;
            font-variant-numeric: tabular-nums;
        }

        .piste-progression {
            position: relative;
            width: 100%;
            height: 10px;
            background: var(--couleur-bordure);
            border-radius: 99px;
            overflow: visible;
        }

        .remplissage-progression {
            height: 100%;
            width: 0%;
            background: var(--couleur-principale);
            border-radius: 99px;
            transition: width 0.1s linear;
        }

        /* Repère doré/rouge indiquant exactement où la pause va tomber */
        .repere-pause {
            position: absolute;
            top: -4px;
            width: 4px;
            height: 18px;
            background: var(--couleur-repere-pause);
            border-radius: 3px;
            box-shadow: 0 0 8px var(--couleur-repere-pause);
            transform: translateX(-50%);
            z-index: 3;
        }

        .repere-pause::after {
            content: "❓";
            position: absolute;
            top: -19px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.72rem;
        }

        /* =====================================================================
           5. BOUTONS TACTILES & CHOIX DE RÉPONSES
           ===================================================================== */
        .btn-principal {
            width: 100%;
            min-height: 52px;
            background-color: var(--couleur-principale);
            color: #05130a;
            font-family: inherit;
            font-weight: 800;
            font-size: 1.02rem;
            padding: 14px 20px;
            border: none;
            border-radius: 14px;
            cursor: pointer;
            transition: transform 0.15s ease, background-color 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-principal:hover {
            background-color: var(--couleur-principale-claire);
        }

        .btn-principal:active {
            transform: scale(0.97);
        }

        .btn-secondaire {
            width: 100%;
            min-height: 48px;
            background-color: rgba(255, 255, 255, 0.04);
            color: var(--couleur-texte);
            border: 1px solid var(--couleur-bordure);
            font-family: inherit;
            font-weight: 600;
            font-size: 0.92rem;
            padding: 10px 14px;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-secondaire:hover {
            border-color: var(--couleur-texte-doux);
            background: rgba(255, 255, 255, 0.09);
        }

        .btn-secondaire:active {
            transform: scale(0.97);
        }

        /* Barre de 3 boutons sous le lecteur */
        .barre-controles {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
            margin-top: 14px;
        }

        @media (max-width: 440px) {
            .barre-controles {
                grid-template-columns: 1fr 1fr;
            }
            .barre-controles #btn-passer-question {
                grid-column: span 2;
            }
        }

        /* Liste des morceaux sur l'écran d'accueil */
        .liste-morceaux-accueil {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin: 18px 0 22px 0;
            text-align: left;
        }

        .carte-morceau-choix {
            width: 100%;
            min-height: 62px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--couleur-bordure);
            border-radius: 14px;
            padding: 12px 16px;
            color: var(--couleur-texte);
            font-family: inherit;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            text-align: left;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        .carte-morceau-choix:hover {
            border-color: var(--couleur-principale);
            background: rgba(29, 185, 84, 0.08);
        }

        /* Grille des 4 options de réponse */
        .grille-options {
            display: flex;
            flex-direction: column;
            gap: 11px;
            margin-top: 16px;
        }

        .btn-option {
            width: 100%;
            min-height: 54px;
            text-align: left;
            background: rgba(255, 255, 255, 0.04);
            border: 2px solid var(--couleur-bordure);
            color: var(--couleur-texte);
            font-family: inherit;
            font-size: 0.96rem;
            font-weight: 600;
            padding: 13px 15px;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-option:hover:not(:disabled) {
            border-color: var(--couleur-principale);
            background: rgba(29, 185, 84, 0.08);
        }

        .btn-option:active:not(:disabled) {
            transform: scale(0.98);
        }

        .btn-option:disabled {
            cursor: default;
        }

        .lettre-option {
            background: var(--couleur-bordure);
            color: var(--couleur-texte);
            min-width: 32px;
            height: 32px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.88rem;
            flex-shrink: 0;
        }

        .btn-option.correct {
            background: rgba(16, 185, 129, 0.2);
            border-color: var(--couleur-succes);
        }
        .btn-option.correct .lettre-option {
            background: var(--couleur-succes);
            color: #000;
        }

        .btn-option.incorrect {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--couleur-erreur);
        }
        .btn-option.incorrect .lettre-option {
            background: var(--couleur-erreur);
            color: #fff;
        }

        /* Citation, feedback et erreurs */
        .citation-paroles {
            background: rgba(255, 255, 255, 0.05);
            border-left: 3px solid var(--couleur-principale);
            padding: 11px 14px;
            border-radius: 8px;
            font-style: italic;
            color: #e5e7eb;
            font-size: 0.94rem;
            margin: 10px 0 14px 0;
        }

        .encart-feedback {
            margin-top: 18px;
            padding: 16px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.05);
            border-left: 4px solid var(--couleur-principale);
        }

        .encart-erreur {
            background: rgba(245, 158, 11, 0.14);
            border: 1px solid var(--couleur-alerte);
            color: #fcd34d;
            padding: 15px;
            border-radius: 14px;
            margin-top: 14px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="conteneur">
        <!-- EN-TÊTE -->
        <header>
            <div class="logo">🎧 Quiz Paroles Hybride</div>
            <div class="badge-score" id="affichage-score">Score : 0 / 0</div>
        </header>

        <!-- ÉCRAN 1 : ACCUEIL -->
        <section id="ecran-accueil" class="carte" style="text-align: center;">
            <div style="font-size: 2.6rem; margin-bottom: 6px;">🎵🎬</div>
            <h1 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 8px;">
                Écoute, observe et décrypte les paroles
            </h1>
            <p style="color: var(--couleur-texte-doux); font-size: 0.94rem;">
                Le lecteur se met automatiquement en pause au repère <strong style="color: var(--couleur-repere-pause);">❓</strong> pour poser la question. Teste dès maintenant avec le mode démo intégré !
            </p>

            <!-- Liste des morceaux générée dynamiquement -->
            <div id="liste-morceaux-accueil" class="liste-morceaux-accueil"></div>

            <button id="btn-demarrer-tout" class="btn-principal">
                ▶ Lancer tout le quiz
            </button>
        </section>

        <!-- ÉCRAN 2 : ZONE DE JEU -->
        <section id="ecran-jeu" class="cache">
            <div class="carte" style="margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; gap: 8px;">
                    <span id="numero-manche" style="font-size: 0.8rem; font-weight: 800; color: var(--couleur-principale); text-transform: uppercase;">
                        Manche 1 / 2
                    </span>
                    <span id="statut-lecture" style="font-size: 0.82rem; color: var(--couleur-texte-doux);">
                        🎧 Lecture en cours...
                    </span>
                </div>

                <div id="info-titre" style="font-size: 1.2rem; font-weight: 800;">Titre</div>
                <div id="info-artiste" style="color: var(--couleur-texte-doux); font-size: 0.92rem; margin-bottom: 12px;">Artiste</div>

                <!-- SCÈNE MÉDIA HYBRIDE (MP4 OU MP3/DÉMO) -->
                <div class="scene-media">
                    <!-- 1. Lecteur vidéo MP4 (affiché uniquement si typeMedia === "mp4") -->
                    <video id="lecteur-video-mp4" class="cache" playsinline preload="metadata"></video>

                    <!-- 2. Lecteur audio MP3 invisible (utilisé si typeMedia === "mp3") -->
                    <audio id="lecteur-audio-mp3" preload="metadata"></audio>

                    <!-- 3. Scène visuelle Pochette + Égaliseur (affichée pour "mp3" et "demo") -->
                    <div id="scene-visuelle-audio" class="scene-audio">
                        <div class="halo-arriere-plan"></div>
                        <div class="contenu-pochette">
                            <div id="cadre-pochette" class="cadre-pochette"></div>
                            <div class="infos-audio-scene">
                                <span id="badge-type-media" class="badge-mode-media">Mode Démo Synthétique</span>
                                <div id="sous-titre-scene" style="font-weight: 700; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    Écoute le passage...
                                </div>
                                <!-- Égaliseur 8 barres -->
                                <div class="egaliseur" aria-hidden="true">
                                    <div class="barre-eq"></div>
                                    <div class="barre-eq"></div>
                                    <div class="barre-eq"></div>
                                    <div class="barre-eq"></div>
                                    <div class="barre-eq"></div>
                                    <div class="barre-eq"></div>
                                    <div class="barre-eq"></div>
                                    <div class="barre-eq"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Overlay lors du déclenchement de la question -->
                    <div id="overlay-pause" class="overlay-pause cache">
                        <div style="font-size: 1.2rem; font-weight: 800;">⏸️ Pause question !</div>
                        <div style="font-size: 0.88rem; color: var(--couleur-texte-doux);">
                            Réponds ci-dessous pour valider tes points 👇
                        </div>
                    </div>
                </div>

                <!-- BARRE DE PROGRESSION AVEC REPÈRE DE PAUSE -->
                <div class="bloc-chronometre">
                    <div class="ligne-temps">
                        <span id="texte-chrono">0:00 / 0:18</span>
                        <span id="texte-repere-pause" style="color: var(--couleur-repere-pause); font-weight: 700;">
                            Pause à 0:18
                        </span>
                    </div>
                    <div class="piste-progression">
                        <div id="remplissage-progression" class="remplissage-progression"></div>
                        <div id="repere-pause" class="repere-pause" style="left: 100%;" title="Moment de la question"></div>
                    </div>
                </div>

                <!-- BOUTONS DE CONTRÔLE TACTILES -->
                <div class="barre-controles">
                    <button id="btn-pause-lecture" class="btn-secondaire">
                        ⏸ Pause
                    </button>
                    <button id="btn-reecouter" class="btn-secondaire">
                        ⏪ Réécouter
                    </button>
                    <button id="btn-passer-question" class="btn-secondaire">
                        ❓ Passer à la question
                    </button>
                </div>

                <!-- ENCART D'ERREUR SI UN FICHIER .MP3 OU .MP4 EST INTROUVABLE -->
                <div id="zone-erreur-fichier" class="encart-erreur cache">
                    <p style="font-weight: 800; margin-bottom: 4px;">⚠️ Fichier audio/vidéo introuvable</p>
                    <p id="detail-erreur-fichier" style="font-size: 0.85rem; margin-bottom: 12px;">
                        Vérifie le chemin indiqué dans <code>fichierMedia</code> ou teste avec le mode démo intégré.
                    </p>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <button id="btn-basculer-demo" class="btn-principal">
                            🎛️ Basculer sur le mode démo intégré
                        </button>
                        <button id="btn-erreur-voir-question" class="btn-secondaire">
                            ❓ Afficher directement la question
                        </button>
                    </div>
                </div>
            </div>

            <!-- CARTE QUESTION (APPARAÎT AUTOMATIQUEMENT À pauseSecondes) -->
            <div id="carte-question" class="carte cache">
                <div style="font-size: 0.78rem; color: var(--couleur-principale); font-weight: 800; text-transform: uppercase;">
                    Question sur les paroles
                </div>

                <div id="texte-citation" class="citation-paroles"></div>

                <h2 id="texte-question" style="font-size: 1.12rem; font-weight: 800; line-height: 1.4;">
                    Question...
                </h2>

                <div id="liste-options" class="grille-options"></div>

                <!-- RÉSULTAT & EXPLICATION -->
                <div id="zone-feedback" class="encart-feedback cache">
                    <div id="titre-feedback" style="font-weight: 800; font-size: 1.1rem; margin-bottom: 6px;"></div>
                    <p id="texte-explication" style="color: var(--couleur-texte-doux); font-size: 0.94rem; margin-bottom: 16px;"></p>

                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <button id="btn-ecouter-suite" class="btn-principal">
                            🔊 Écouter la suite de l'extrait
                        </button>
                        <button id="btn-manche-suivante" class="btn-secondaire">
                            Continuer vers la suite ➔
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ÉCRAN 3 : FIN DE PARTIE -->
        <section id="ecran-fin" class="carte cache" style="text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 8px;">🏆</div>
            <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 8px;">Quiz terminé !</h2>
