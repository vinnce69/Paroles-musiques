    <script>
        // =====================================================================
        // 1. CONFIGURATION DES MORCEAUX ET QUESTIONS (MODIFIE ICI FACILEMENT !)
        // =====================================================================
        // GUIDE RAPIDE POUR PERSONNALISER TES CHANSONS :
        // - typeMedia :
        //     * "demo" : fonctionne immédiatement sans aucun fichier externe (rythme synthétique + pochette générée).
        //     * "mp3"  : lit ton fichier audio (ex: "audios/nes.mp3" ou lien https://...mp3) + pochette + égaliseur.
        //     * "mp4"  : lit ton extrait clip vidéo (ex: "videos/nes.mp4" ou lien https://...mp4) en 16:9.
        // - fichierMedia : chemin local ou URL vers ton fichier .mp3 ou .mp4 (ignoré si typeMedia = "demo").
        // - pochetteUrl  : lien vers une image d'album (laisser "" pour générer une pochette design automatique).
        // - couleurPochette : couleur dominante de la pochette générée automatiquement.
        // - debutSecondes / pauseSecondes / repriseFinSecondes : repères précis en secondes.

        const CHANSONS = [
            {
                titre: "La lune attire la mer (Veridis Remix)",
                artiste: "Alpha Wann (Veridis Project)",
                // Pour passer sur ton vrai fichier, remplace "demo" par "mp3" ou "mp4"
                // et indique son chemin dans fichierMedia (ex: "medias/nes-des-pieds-et-des-mains.mp3")
                typeMedia: "mp4",
                fichierMedia: "medias/XXXXX",
                pochetteUrl: "",
                couleurPochette: "#1db954",
                tirageAleatoire: true,
                nombreQuestionsAPoser: 1,
                banqueQuestions: [
                    {
                        debutSecondes: 0,
                        pauseSecondes: 12,
                        repriseFinSecondes: 18,
                        citation: "« J'fais des pieds et des mains pour qu'on s'en sorte, j'ai laissé les regrets... »",
